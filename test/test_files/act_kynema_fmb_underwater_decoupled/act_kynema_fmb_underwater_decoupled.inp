#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            SIMULATION STOP            #
#.......................................#
time.stop_time               =  -1.     # Max (simulated) time to evolve
time.max_step                =  500          # Max number of time steps
#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#         TIME STEP COMPUTATION         #
#.......................................#
time.fixed_dt         =   0.1        # Use this constant dt if > 0
time.cfl              =   0.95       # CFL factor
time.use_force_cfl    =   0
#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            INPUT AND OUTPUT           #
#.......................................#
time.plot_interval            =  1       # Steps between plot files
time.checkpoint_interval      =  -3        # Steps between checkpoint files
io.outputs = actuator_src_term

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#               PHYSICS                 #
#.......................................#
incflo.gravity        =  0.0  0.0 -9.81  # Gravitational force (3D)

transport.model = TwoPhaseTransport
turbulence.model = Laminar

incflo.field_boundaries = BoundaryPlane Flather
BoundaryPlane.planes =  xlo xhi
BoundaryPlane.file = bndry_plane
BoundaryPlane.var_names = velocity vof density
BoundaryPlane.output_format = native
BoundaryPlane.is_static = true
BoundaryPlane.output_and_use_initial_plane = true
BoundaryPlane.io_mode = 1

incflo.physics = MultiPhase ChannelBuilder Actuator
MultiPhase.density_fluid1 = 1000.
MultiPhase.density_fluid2 = 1.225
ICNS.source_terms = GravityForcing DragForcing ActuatorForcing
ICNS.use_perturb_pressure = true
ChannelBuilder.segment_labels = s1

ChannelBuilder.s1.flow_speed = 1.5
ChannelBuilder.s1.velocity_profile = Uniform
ChannelBuilder.s1.type = Trapezoid
ChannelBuilder.s1.top_width_start = 120
ChannelBuilder.s1.top_width_end = 120
ChannelBuilder.s1.bottom_width_start = 60
ChannelBuilder.s1.bottom_width_end = 60
ChannelBuilder.s1.height_start = 80
ChannelBuilder.s1.height_end = 80
ChannelBuilder.s1.segment_start_point = -1. 0. 0.
ChannelBuilder.s1.segment_end_point =  201. 0. 0.

ChannelBuilder.water_level = 0.
ChannelBuilder.land_level = 18.

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#        ADAPTIVE MESH REFINEMENT       #
#.......................................#
amr.n_cell              = 96 48 48 # Grid cells at coarsest AMRlevel
amr.max_level           = 0           # Max AMR level in hierarchy

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              GEOMETRY                 #
#.......................................#
geometry.prob_lo        =   0.     -37.5  -50.  # Lo corner coordinates
geometry.prob_hi        =   150.    37.5   25.  # Hi corner coordinates
geometry.is_periodic    =   0   0   0   # Periodicity x y z (0/1)
# Boundary conditions
xlo.type =   "mass_inflow"
xlo.density = 1.225
xlo.vof     = 0
xhi.type =   "mass_inflow"
xhi.density = 1.225
xhi.vof     = 0
ylo.type =   "slip_wall"
yhi.type =   "slip_wall"
zlo.type =   "slip_wall"
zhi.type =   "slip_wall"

Actuator.type                            = TurbineKynemaFMBLine     
Actuator.TurbineKynemaFMBLine.epsilon       = 5.0 5.0 5.0   
Actuator.TurbineKynemaFMBLine.epsilon_tower = 0.0 0.0 0.0         
Actuator.TurbineKynemaFMBLine.fllc          = false 
Actuator.labels                          = T0
Actuator.T0.base_position                = 50.0 0.0 -50.0

Actuator.T0.decouple_structure_from_aero_loading = 1
Actuator.T0.kynema_fmb_input_file  = RM1-aero.yaml
Actuator.T0.num_struct_nodes_blade = 11
Actuator.T0.num_struct_nodes_tower = 11
Actuator.T0.num_points_blade       = 50
Actuator.T0.num_points_tower       = 0
Actuator.T0.rot_speed_rpm          = 11.5
Actuator.T0.dt                     = 0.1
Actuator.T0.fllc                   = false
Actuator.T0.density                = 1e3
Actuator.T0.nacelle_drag_coeff     = 0.0
Actuator.T0.nacelle_area           = 0.0                 
Actuator.T0.output_frequency       = 1                   
Actuator.T0.num_blades             = 2