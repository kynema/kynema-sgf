# Periodic 4 x 4 columns with a uniform forest (h = 20 m, LAI = 2, Cd = 0.2)
# on flat ground raised to 20 m. KLAxell with the canopy TKE source and the
# canopy length scale limit (ForestDrag.canopy_tke = true).

geometry.prob_lo = 0 0 0
geometry.prob_hi = 40 40 220.0
geometry.is_periodic = 1 1 0
amr.n_cell = 4 4 110
amr.max_level = 0
amr.blocking_factor = 2
amr.max_grid_size = 4 4 22
time.stop_time = -100.0
time.max_step = 10
time.fixed_dt = -1.0
time.cfl = 0.5
time.plot_interval = 10
time.checkpoint_interval = -1
io.outputs = mu_turb tke turb_lscale forest_drag forest_id terrainz0 terrain_height shear_prod dissipation
io.int_outputs = terrain_blank terrain_drag
incflo.physics = ABL TerrainDrag ForestDrag
incflo.density = 1.0
incflo.gravity = 0. 0. -9.81
incflo.velocity = 5.0 0.0 0.0
incflo.verbose = 0
incflo.initial_iterations = 3
incflo.do_initial_proj = true
incflo.constant_density = true
incflo.use_godunov = true
incflo.godunov_type = "ppm"
incflo.diffusion_type = 2
transport.model = ConstTransport
transport.viscosity = 1.0e-5
transport.laminar_prandtl = 0.7
transport.turbulent_prandtl = 0.333
transport.reference_temperature = 300.0
turbulence.model = KLAxell
TKE.source_terms = KransAxell
ICNS.source_terms = BodyForce DragForcing ForestForcing
BodyForce.magnitude = 1.2500000000e-03 0.0 0.0
ABL.initial_wind_profile = false
ABL.rans_1dprofile_file = "rans_1d.info"
ABL.meso_sponge_start = 1.0e6
ABL.surface_roughness_z0 = 0.1
ABL.surface_temp_flux = 0.0
ABL.kappa = 0.41
ABL.normal_direction = 2
ABL.perturb_velocity = false
ABL.perturb_temperature = false
ABL.temperature_heights = 0.0 220.0
ABL.temperature_values = 300.0 300.0
ABL.init_tke = 0.5
ABL.wall_shear_stress_type = local
ABL.stats_output_format = ascii
TerrainDrag.terrain_file = "terrain.amrwind"
ForestDrag.forest_file = "forest.amrwind"
zlo.type = "wall_model"
zlo.tke_type = "fixed_gradient"
zlo.tke = 0.0
zhi.type = "slip_wall"
zhi.temperature_type = "fixed_gradient"
zhi.temperature = 0.0
zhi.tke_type = "fixed_gradient"
zhi.tke = 0.0
ForestDrag.canopy_tke = true
