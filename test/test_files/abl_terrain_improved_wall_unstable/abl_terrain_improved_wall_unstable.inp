# Gaussian hill with TerrainDrag and KLAxell under a unstable mol surface layer,
# improved near-wall treatment (TerrainDrag.wall_treatment = improved)
geometry.prob_lo                  = 0.0 0.0 0.0
geometry.prob_hi                  = 1280.0 1280.0 1040.0
geometry.is_periodic              = 1 1 0
amr.n_cell                        = 32 32 52
amr.max_level                     = 0
amr.max_grid_size                 = 32
amr.blocking_factor               = 2
time.max_step                     = 10
time.fixed_dt                     = 1.0
time.cfl                          = 0.9
time.regrid_interval              = -1
time.checkpoint_interval          = -1
time.plot_interval                = 10
incflo.physics                    = ABL TerrainDrag
incflo.density                    = 1.225
incflo.gravity                    = 0.0 0.0 -9.81
incflo.velocity                   = 15.0 0.0 0.0
incflo.verbose                    = 2
incflo.initial_iterations         = 3
incflo.do_initial_proj            = true
incflo.constant_density           = true
incflo.use_godunov                = true
incflo.godunov_type               = "ppm"
incflo.diffusion_type             = 2
transport.model                   = ConstTransport
transport.viscosity               = 1.0e-5
transport.laminar_prandtl         = 0.7
transport.turbulent_prandtl       = 0.3333
transport.reference_temperature   = 301.650820
transport.thermal_expansion_coefficient = 3.315091270e-03
turbulence.model                  = KLAxell
TKE.source_terms                  = KransAxell
ABL.kappa                         = 0.41
ABL.normal_direction              = 2
ABL.surface_roughness_z0          = 0.1
ABL.wall_shear_stress_type        = local
ABL.perturb_velocity              = false
ABL.perturb_temperature           = false
ABL.wall_het_model                = "mol"
ABL.monin_obukhov_length          = -186.128064
ABL.surface_temp_flux             = 0.05
ABL.meso_sponge_start             = 1e30
ABL.initial_wind_profile          = true
ABL.rans_1dprofile_file           = "rans_1d.info"
ABL.terrain_aligned_profile       = true
